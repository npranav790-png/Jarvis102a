# ==============================================================================
# JARVIS 2.0 — Production & Development Environment Configuration Template
# NOTE: Copy this file to .env and customize. Never commit real credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SAFE DEFAULTS (Runtime & Logging)
# ------------------------------------------------------------------------------
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=text
JARVIS_OFFLINE=false

# ------------------------------------------------------------------------------
# 2. PRIVACY & SECURITY POLICIES
# ------------------------------------------------------------------------------
# Modes: CLOUD_ONLY | CLOUD_PREFERRED | ALLOW_CLOUD | PREFER_LOCAL | LOCAL_ONLY
JARVIS_PRIVACY_MODE=CLOUD_ONLY

# Security Modes: strict | permissive | autonomous
JARVIS_SECURITY_MODE=strict

# Approval Threshold for dangerous operations: HIGH | CRITICAL
JARVIS_APPROVAL_THRESHOLD=HIGH

# ------------------------------------------------------------------------------
# 3. ZERO-COST HARD GUARANTEES (CRITICAL REQUIREMENT: $0 / ₹0)
# ------------------------------------------------------------------------------
# Blocks all billing/paid models. Paid providers cannot be registered.
JARVIS_ALLOW_PAID_PROVIDERS=false
ALLOW_PAID_PROVIDERS=false
JARVIS_MAX_COST_PER_DAY=0.00
JARVIS_ALLOW_FREE_MODELS_ONLY=true

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Path to SQLite database file. Use ":memory:" for ephemeral test runs.
JARVIS_DB_PATH=data/jarvis.db

# ------------------------------------------------------------------------------
# 5. REST API & WEBSOCKET SERVER
# ------------------------------------------------------------------------------
JARVIS_API_ENABLED=true
JARVIS_API_PORT=8787
JARVIS_API_HOST=127.0.0.1
JARVIS_WS_ENABLED=true
JARVIS_API_VERSION=v1
JARVIS_MAX_BODY_SIZE_MB=10
# Optional custom API secret for HMAC signing tokens (random fallback generated if blank)
JARVIS_API_SECRET=
JARVIS_ACCESS_TOKEN_TTL_SECONDS=3600
JARVIS_REFRESH_TOKEN_TTL_SECONDS=2592000

# ------------------------------------------------------------------------------
# 6. AI CLOUD PROVIDERS (Zero-Cost & Free Tier Only)
# ------------------------------------------------------------------------------
# Google Gemini (Free Tier: Gemini 3.7 Flash, 3.5 Flash, 3.1 Flash Lite)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_REQUESTS_PER_MINUTE=15
GEMINI_MAX_REQUESTS_PER_DAY=1500
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Charon
JARVIS_VOICE_TTS_PROVIDER=gemini-tts
JARVIS_VOICE_CACHE_ENABLED=true
JARVIS_VOICE_CACHE_TTL_SECONDS=300

# Groq Cloud (Free Tier - ultra-fast inference with Llama 3.3 70B & 8B)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (Free Tier Models)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face Serverless (Free)
HUGGINGFACE_API_KEY=

# Tie-breaking priority order (comma-separated providers)
JARVIS_PROVIDER_PRIORITY=gemini,groq,openrouter,huggingface,ollama

# Default / Preferred Model (Optional, overrides auto-selection):
# Local Qwen options (run `ollama run qwen3.5:8b` or `ollama run qwen2.5:8b`):
# JARVIS_DEFAULT_MODEL=qwen3.5:8b
# JARVIS_DEFAULT_MODEL=qwen2.5:8b
# Cloud Free Qwen options (via OpenRouter or HuggingFace):
# JARVIS_DEFAULT_MODEL=qwen/qwen-2.5-7b-instruct:free
# JARVIS_DEFAULT_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# JARVIS_DEFAULT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
JARVIS_DEFAULT_MODEL=

# Local Ollama Provider (for local models like Qwen 3.5 8B, Llama 3):
# Set JARVIS_PRIVACY_MODE=PREFER_LOCAL to prioritize local Ollama models.
JARVIS_ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 7. EXECUTION & REASONING LIMITS
# ------------------------------------------------------------------------------
JARVIS_DEFAULT_TASK_TIMEOUT_MS=60000
JARVIS_MAX_TASK_RETRIES=3
JARVIS_MAX_AGENT_ITERATIONS=10
JARVIS_MAX_REPLANS=3
JARVIS_CONTEXT_TOKEN_BUDGET=8192
