{
  "mcpServers": {
    "sqlite-explorer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "data/jarvis.db"],
      "transport": "STDIO",
      "trustLevel": "SANDBOXED",
      "description": "Direct SQLite querying tool via MCP",
      "enabled": false
    },
    "remote-tools": {
      "url": "http://127.0.0.1:8000/sse",
      "transport": "SSE",
      "trustLevel": "UNTRUSTED",
      "description": "Remote microservices MCP endpoint",
      "enabled": false
    }
  }
}
